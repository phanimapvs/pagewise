<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ cloud backup and phone-to-phone transfer. Only the newest automatic backup
    zip is included: it already holds the database, settings and quote photos, and copying
    the live Room files could catch them mid-write. Restore it from the onboarding screen.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="autobackup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="autobackup/" />
    </device-transfer>
</data-extraction-rules>
